-- Bonum Canonical Schema (Quereus SQL)
-- Authoritative executable schema for all targets/backends.
-- Human-readable field documentation: schema.md (this file is the executable form).
--
-- Notes:
--   * Amounts are integers in the smallest unit (see units.md).
--   * Tables are backed by a Quereus vtable module (the app sets
--     `pragma default_vtab_module = 'store'` before applying, so plain
--     `create table` binds to the active store — IndexedDB for the web).
--   * Quereus does not enforce ON DELETE CASCADE — deletes that must cascade
--     (e.g. removing a transaction's entries) are ordered explicitly in the data
--     service. See rules.md for the invariants.
--   * Entry.amount: quantity in the ACCOUNT's unit; positive = debit, negative =
--     credit. Entry.value restates it in txn.value_unit (the transaction's
--     "reckoning unit"). A txn balances when sum(value)=0, or sum(amount)=0 when
--     value_unit is null (single-unit txn). See units.md.

create table unit (
  code text primary key,
  name text,
  symbol text null,
  unit_type text,
  display_divisor integer default 100,
  constraint chk_unit_type check (unit_type in ('FIAT','CRYPTO','COMMODITY','SECURITY','INVENTORY','OTHER'))
);

create table account_group (
  id text primary key,
  name text,
  account_type text,
  parent_id text null,
  description text null,
  display_order integer null,
  constraint chk_ag_type check (account_type in ('ASSET','LIABILITY','EQUITY','INCOME','EXPENSE')),
  constraint fk_ag_parent foreign key (parent_id) references account_group(id)
);

create table entity (
  id text primary key,
  name text,
  description text null,
  fiscal_year_end text null,
  base_unit text,
  default_costing_method text null,
  -- Read-side denormalizations, maintained on write. The store cannot seek a range or an aggregate
  -- without paying per-row cursor cost over the whole table (see tmp/quereus-4.11-range-and-indexed-reads.md),
  -- so anything a report needs about "the books as a whole" is kept here and read with the entity row.
  -- max_entry_date: latest entry date, so a past balance knows how far its tail runs. Raised only,
  -- never lowered -- over-estimating costs a few empty-month probes, under-estimating is a wrong balance.
  max_entry_date text null,
  -- reckoning_units: comma-separated set of txn.value_unit ever used, so a report knows whether a
  -- cost-basis figure is already denominated in the display unit (and therefore exact).
  reckoning_units text null,
  -- entry_periods: the 'YYYY-MM' buckets that actually hold entries. Lets the backward tail probe only
  -- months that exist instead of walking a contiguous range -- with entries dated 2028 the range is
  -- mostly empty months, each costing a seek. Over-listing is harmless (a probe that finds nothing).
  entry_periods text null,
  created_at text,
  updated_at text,
  constraint fk_entity_unit foreign key (base_unit) references unit(code),
  constraint chk_entity_costing check (default_costing_method is null or default_costing_method in ('FIFO','LIFO','AVERAGE'))
);

create table partner (
  id text primary key,
  name text,
  type text null,
  email text null,
  phone text null,
  address text null,
  notes text null,
  is_active integer default 1,
  created_at text,
  updated_at text,
  constraint chk_partner_type check (type is null or type in ('VENDOR','CUSTOMER','BOTH'))
);

create table account (
  id text primary key,
  entity_id text,
  account_group_id text not null,
  parent_id text null,
  code text null,
  name text,
  description text null,
  unit text,
  costing_method text null,
  closed_through text null,
  partner_id text null,
  linked_account_id text null,
  is_active integer default 1,
  source_id text null,
  created_at text,
  updated_at text,
  constraint uq_account_code unique (entity_id, code),
  -- Single logical path: an account's parent is either its group (parent_id null) or another account;
  -- a nested account MUST share its parent account's group, so group-path + account-path never fork.
  -- The composite FK enforces this (and is not enforced when parent_id is null). uq target for that FK:
  constraint uq_account_id_group unique (id, account_group_id),
  constraint fk_account_entity foreign key (entity_id) references entity(id),
  constraint fk_account_group foreign key (account_group_id) references account_group(id),
  constraint fk_account_parent foreign key (parent_id, account_group_id) references account(id, account_group_id),
  constraint fk_account_unit foreign key (unit) references unit(code),
  constraint fk_account_partner foreign key (partner_id) references partner(id),
  constraint fk_account_linked foreign key (linked_account_id) references account(id),
  constraint chk_account_costing check (costing_method is null or costing_method in ('FIFO','LIFO','AVERAGE'))
);

create table tag (
  id text primary key,
  name text,
  description text null,
  parent_id text null,
  constraint fk_tag_parent foreign key (parent_id) references tag(id)
);

create table txn (
  id text primary key,
  entity_id text,
  date text,
  memo text null,
  reference text null,
  -- Reckoning unit: the unit entry.value is expressed in. NULL = single-unit txn (balance is
  -- sum(amount)=0). May be ANY unit, not just a currency -- see units.md.
  value_unit text null,
  source_id text null,
  created_at text,
  updated_at text,
  constraint fk_txn_entity foreign key (entity_id) references entity(id),
  constraint fk_txn_value_unit foreign key (value_unit) references unit(code)
);

create table reconciliation (
  id text primary key,
  account_id text,
  statement_date text,
  ending_balance integer,
  reconciled_at text null,
  notes text null,
  constraint fk_recon_account foreign key (account_id) references account(id)
);

create table entry (
  id text primary key,
  txn_id text,
  account_id text,
  amount integer,        -- quantity in the ACCOUNT's unit, smallest increment: + debit / - credit
  value integer null,    -- same entry restated in txn.value_unit -- null means "same as amount"
  note text null,
  tag_id text null,
  reconciliation_id text null,
  constraint fk_entry_txn foreign key (txn_id) references txn(id),
  constraint fk_entry_account foreign key (account_id) references account(id),
  constraint fk_entry_tag foreign key (tag_id) references tag(id),
  constraint fk_entry_recon foreign key (reconciliation_id) references reconciliation(id)
);

-- Reference rates ONLY: observed quotes used to value holdings at report time. Transaction-time
-- rates are NOT here -- they live on the entries as value/amount, which allows a different rate per
-- entry (one sale can fill at several prices). See units.md.
create table exchange (
  id text primary key,
  date text,
  unit_a text,
  unit_b text,
  rate_numerator integer,      -- 1 unit_a = (num/denom) unit_b, exact rational (never a decimal)
  rate_denominator integer,
  source text,
  notes text null,
  constraint fk_exchange_unit_a foreign key (unit_a) references unit(code),
  constraint fk_exchange_unit_b foreign key (unit_b) references unit(code),
  constraint chk_exchange_source check (source in ('MARKET','MANUAL'))
);

-- Secondary indexes for common joins/filters (FKs are NOT auto-indexed).
-- Without these the entry⋈txn⋈account joins degrade to nested scans at scale.
create index idx_account_entity on account(entity_id);
create index idx_account_group on account(account_group_id);
create index idx_entry_txn on entry(txn_id);
create index idx_entry_account on entry(account_id);

-- txn is always queried entity-first: getBalanceSheet (entity_id = ? and date <= ?), getTransactions
-- (entity_id = ? [and date range] order by date), getLedger (entity_id = ?). No query filters date alone.
-- One composite (entity_id, date) serves all of them (prefix covers entity-only + the entity FK check,
-- and the date column adds range pruning + ordering) — strictly better than two single-column indexes.
create index idx_txn_entity_date on txn(entity_id, date);

-- Index EVERY FK child column. Standard SQL hygiene: without a child-side index, a DELETE/UPDATE on the
-- parent must scan the child table once per affected parent row to enforce the FK (O(parent×child) — a
-- 1000-row entity delete took ~49s). With these, the referential check is an index seek (~0.5ms/row).
-- (On the IndexedDB store the check is still ~35ms/row even indexed — see tmp/quereus-fk-delete-perf.md —
-- so bulk cascades additionally disable FK enforcement; these indexes remain correct for other backends.)
create index idx_ag_parent on account_group(parent_id);
create index idx_account_parent on account(parent_id);
create index idx_account_partner on account(partner_id);
create index idx_account_linked on account(linked_account_id);
create index idx_tag_parent on tag(parent_id);
create index idx_recon_account on reconciliation(account_id);
create index idx_entry_tag on entry(tag_id);
create index idx_entry_recon on entry(reconciliation_id);
-- Rate lookup is always "pair, most recent at or before a date" -> composite prefix + range.
create index idx_exchange_pair_date on exchange(unit_a, unit_b, date);
