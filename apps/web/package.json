{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:quereus": "VITE_BACKEND=quereus-local vite dev",
    "dev:p2p": "VITE_BACKEND=quereus-p2p vite dev",
    "dev:mock": "VITE_BACKEND=mock vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "postinstall": "cp node_modules/sql.js/dist/sql-wasm.wasm static/",
    "test:unit": "TZ=UTC vitest run",
    "perf": "node perf/run.mjs",
    "test": "yarn test:unit && yarn test:e2e",
    "test:e2e": "playwright test",
    "test:regression": "playwright test -c playwright.regression.config.ts",
    "test:all": "yarn test && yarn test:regression"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.56",
    "@ai-sdk/google": "^2.0.46",
    "@ai-sdk/openai": "^2.0.86",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/interface": "3.2.4",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/websockets": "^10.1.16",
    "@noble/hashes": "^2.2.0",
    "@optimystic/db-core": "^0.22.0",
    "@optimystic/db-p2p": "^0.22.0",
    "@optimystic/db-p2p-storage-web": "^0.22.0",
    "@optimystic/quereus-plugin-crypto": "^0.22.0",
    "@optimystic/quereus-plugin-optimystic": "^0.22.0",
    "@quereus/isolation": "4.12.0",
    "@quereus/plugin-indexeddb": "4.12.0",
    "@quereus/quereus": "4.12.0",
    "@quereus/store": "4.12.0",
    "@serfab/cadre-core": "^0.10.0",
    "ai": "^5.0.113",
    "buffer": "^6.0.3",
    "libp2p": "3.3.4",
    "lucide-svelte": "^0.562.0",
    "p2p-fret": "^0.6.0",
    "pako": "^2.1.0",
    "readable-stream": "^4.5.2",
    "sql.js": "^1.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/pako": "^2.0.4",
    "@types/readable-stream": "^4",
    "@types/sql.js": "^1.4.9",
    "playwright": "^1.61.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@quereus/quereus": "^4.12.0",
    "@quereus/isolation": "^4.12.0",
    "@quereus/store": "^4.12.0",
    "@quereus/plugin-indexeddb": "^4.12.0",
    "@optimystic/db-core": "^0.22.0",
    "@optimystic/db-p2p": "^0.22.0",
    "@optimystic/db-p2p-storage-web": "^0.22.0",
    "@optimystic/quereus-plugin-optimystic": "^0.22.0",
